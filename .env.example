# Naury Utility - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# Supabase Configuration (for licensing)
NAURY_SUPABASE_URL=https://your-project.supabase.co
NAURY_SUPABASE_KEY=your-publishable-key-here

# Telegram Bot Configuration (for security alerts)
NAURY_TELEGRAM_TOKEN=your-bot-token-here
NAURY_TELEGRAM_CHAT_ID=your-chat-id-here